# GastroCare backend — Foundation environment template.
# Copy to .env for local/test use. Never commit real secrets or a real .env file.

# Disposable/test PostgreSQL only (see docker-compose.test.yml at repo root).
DATABASE_URL="postgresql://gastrocare_test:gastrocare_test@localhost:55432/gastrocare_foundation_test?schema=public"

# JWT signing secret — Foundation/test only. MUST be replaced with a securely
# generated secret (and a real secrets manager) before any shared/production use.
JWT_SECRET="foundation-dev-only-change-me"
JWT_EXPIRES_IN_SECONDS=900

PORT=3000
