// GastroCare — Prisma schema.
//
// Foundation models (Gate 2 — see docs/07_ROADMAP_AND_GATES.md): Tenant,
// AuthUser, FoundationProbeRecord. FoundationProbeRecord is kept temporarily
// per CONTRIBUTING.md ("FoundationProbeRecord lifecycle note") — CORE-01 adds
// equivalent tenant-isolation regression coverage using real Core models
// (see backend/test/core01-clinical-walking-skeleton.e2e-spec.ts), but the
// probe model itself is left in place; its removal is deferred to its own
// explicit, reviewed migration rather than bundled into this one.
//
// GastroCare Core clinical domain (CORE-01 — CLINICAL CORE WALKING SKELETON):
// Patient, Encounter, CarePlan/CarePlanVersion, CareTask, AuditEvent.
// PatientTimeline is intentionally NOT a model — it is a read projection
// composed from Encounter/CarePlan/CareTask (see docs/04_CORE_DOMAIN_MODEL.md).
// CareEpisode and Encounter clinical time are implemented in CORE-04 T1.
//
// Clinical Forms (CORE-03 — real-world clinical form alignment, see
// design/REAL_WORLD_FORM_ALIGNMENT.md): ClinicalFormSubmission only. Template
// field/section/score definitions (which fields exist, their types, and how
// derived scores are computed) are code-configuration in
// backend/src/clinical-forms/templates — deliberately NOT modeled in the
// database, to avoid a generic low-code form-builder. Only the (templateKey,
// templateVersion) identity is persisted per submission, so a historical
// submission always resolves against the exact template version it was
// captured under, even after a newer version is introduced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant — the isolation boundary for all GastroCare data.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  authUsers                  AuthUser[]
  foundationProbeItems       FoundationProbeRecord[]
  patients                   Patient[]
  careEpisodes               CareEpisode[]
  encounters                 Encounter[]
  carePlans                  CarePlan[]
  carePlanVersions           CarePlanVersion[]
  careTasks                  CareTask[]
  careTaskContactAttempts    CareTaskContactAttempt[]
  auditEvents                AuditEvent[]
  clinicalFormSubmissions    ClinicalFormSubmission[]
  facilities                 Facility[]
  rooms                      Room[]
  clinicianAssignmentHistory ClinicianAssignmentHistory[]

  treatmentPathways    TreatmentPathway[]
  investigations       Investigation[]
  investigationOrders  InvestigationOrder[]
  investigationResults InvestigationResult[]

  // DEC-019 — Staff Profile & Credential Management v1.
  staffProfiles            StaffProfile[]
  staffCredentials         StaffCredential[]
  employmentHistory        EmploymentHistory[]
  staffFacilityAssignments StaffFacilityAssignment[]

  @@map("tenants")
}

/// Minimal Core clinical authorization role (CORE-01 section 12).
/// DOCTOR: full clinical access within their tenant.
/// RECEPTIONIST: patient registration/lookup only, no detailed clinical content.
enum AuthRole {
  DOCTOR
  RECEPTIONIST
  NURSE
}

/// AuthUser lifecycle status (DEC-018). ACTIVE users can authenticate and act;
/// DISABLED users cannot login, any previously issued token is rejected, and
/// they cannot be selected as clinician / handover / assignment targets.
enum AuthUserStatus {
  ACTIVE
  DISABLED
}

/// AuthUser — infrastructure authentication identity.
/// This is NOT Patient and is NOT a clinical domain entity.
model AuthUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         AuthRole @default(DOCTOR)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())

  // DEC-018 — Admin Boundary / User Management v1.
  // displayName: optional human-facing name managed by Clinic Admin.
  // isClinicAdmin: independent administrative capability — NOT an operational
  //   role. Any ACTIVE tenant user may hold it. Operational role never confers
  //   administrative authority.
  // status: ACTIVE | DISABLED lifecycle (see AuthUserStatus).
  // mustChangePassword: forces a password change before any normal action.
  // sessionVersion: bumped on change-password / password-reset / disable to
  //   revoke every previously issued token immediately.
  displayName        String?
  isClinicAdmin      Boolean        @default(false)
  status             AuthUserStatus @default(ACTIVE)
  mustChangePassword Boolean        @default(false)
  sessionVersion     Int            @default(0)
  updatedAt          DateTime       @updatedAt

  responsibleForEncounters Encounter[]                  @relation("EncounterResponsibleClinician")
  createdEncounters        Encounter[]                  @relation("EncounterCreatedBy")
  clinicianAssignments     ClinicianAssignmentHistory[] @relation("AssignmentClinician")

  // DEC-019 — optional 1:1 professional profile (never auth/clinical authority).
  staffProfile StaffProfile?

  @@index([tenantId])
  @@map("auth_users")
}

/// FoundationProbeRecord — neutral, temporary model used only to prove
/// tenant isolation during Gate 2. Not GastroCare Core. Removable via a
/// reviewed migration (see CONTRIBUTING.md "FoundationProbeRecord lifecycle
/// note" — not removed in CORE-01).
model FoundationProbeRecord {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  label     String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("foundation_probe_records")
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

/// Patient — root of all clinical data. Patient.id is the immutable internal
/// identity. fullName/dateOfBirth/phone are matching SIGNALS only, never
/// identity — see docs/04_CORE_DOMAIN_MODEL.md. GastroCare never auto-merges
/// patients on matching signals.
model Patient {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  fullName           String
  normalizedFullName String
  dateOfBirth        DateTime      @db.Date
  gender             PatientGender
  phone              String
  normalizedPhone    String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  encounters              Encounter[]
  careEpisodes            CareEpisode[]
  carePlans               CarePlan[]
  careTasks               CareTask[]
  clinicalFormSubmissions ClinicalFormSubmission[]
  treatmentPathways       TreatmentPathway[]
  investigations          Investigation[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, normalizedFullName])
  @@index([tenantId, normalizedPhone])
  @@map("patients")
}

/// DEC-015 — a generic, nullable Encounter workflow-identity extension
/// point. v1 defines exactly one value; that this value is Hemorrhoid-
/// specific does NOT make Core permanently Hemorrhoid-specific — future
/// workflows may add their own values here. Longo and Hemorrhoid Return
/// continue to derive workflow identity from CareEpisode.episodeType and
/// must NOT be duplicated into this field. workflowKind is NEVER inferred
/// from reasonForVisit / clinical text / ClinicalForm existence / URL /
/// task existence / frontend state. Existing rows remain NULL (no backfill).
enum EncounterWorkflowKind {
  HEMORRHOID_INITIAL
}

/// DEC-021 NR-03 — explicit clinical lifecycle for an Encounter. Nullable on
/// the model: historical rows stay NULL (legacy/unknown, NOT REGISTERED) — no
/// backfill. New Encounter Contexts are created as REGISTERED by application
/// code. `POST /encounters/:id/start` moves REGISTERED -> IN_PROGRESS and
/// `POST /encounters/:id/end` moves IN_PROGRESS -> COMPLETED, both DOCTOR-only
/// and audited. This is distinct from `occurredAt` (encounter occurrence/timing)
/// which is NOT redefined as the clinical start time.
enum EncounterClinicalStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
}

/// Encounter — one manual clinical visit. ClinicalNote in CORE-01 is content
/// belonging to Encounter (reasonForVisit/clinicalNote/assessment fields),
/// not an independent entity — see docs/04_CORE_DOMAIN_MODEL.md. There is
/// intentionally no update/PATCH endpoint for Encounter in CORE-01: the
/// absence of a write path is the simplest safe lifecycle satisfying "no
/// free unrestricted overwrite of finalized clinical content".
model Encounter {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id])
  episodeId String?
  episode   CareEpisode? @relation(fields: [episodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The clinician currently clinically responsible for this Encounter.
  /// DEC-010 §A: generalized/migrated from the former `doctorId` column,
  /// which conflated "responsible clinician" with "actor who created the
  /// row". This field can change over time via handover (see
  /// ClinicianAssignmentHistory) — it is NEVER inferred from createdByUserId
  /// or any other provenance/actor field, and vice versa.
  responsibleClinicianId String
  responsibleClinician   AuthUser @relation("EncounterResponsibleClinician", fields: [responsibleClinicianId], references: [id])

  /// The actor (AuthUser) who created this Encounter row — pure provenance,
  /// distinct from responsibleClinicianId. DEC-010 §A.
  createdByUserId String
  createdBy       AuthUser @relation("EncounterCreatedBy", fields: [createdByUserId], references: [id])

  /// Physical location (DEC-010 §C) — Tenant remains the security/customer
  /// workspace boundary; Room/Facility is the physical care location,
  /// intentionally a separate concept. Nullable: not every historical or
  /// legacy Encounter has a physical room recorded.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  reasonForVisit String
  /// Optional at creation time: a Receptionist creating an Encounter
  /// Context (DEC-010 §B) has no clinical content to record yet — the
  /// Hemorrhoid Examination clinical form captures that later. Defaults to
  /// empty string, never fabricated.
  clinicalNote   String                 @default("")
  assessment     String                 @default("")
  source         String                 @default("MANUAL")
  /// DEC-015 M0 — nullable; set explicitly by future application code only
  /// (initial Hemorrhoid Encounter -> HEMORRHOID_INITIAL). No default, no
  /// backfill; existing rows stay NULL.
  workflowKind   EncounterWorkflowKind?
  occurredAt     DateTime
  createdAt      DateTime               @default(now())

  /// DEC-021 NR-03 — explicit clinical lifecycle. NULL for historical rows
  /// (no backfill); set to REGISTERED by application code at creation for
  /// new Encounters. See EncounterClinicalStatus.
  clinicalStatus    EncounterClinicalStatus?
  clinicalStartedAt DateTime?
  clinicalEndedAt   DateTime?

  /// DEC-021 §3.3 — machine-checkable Structured Treatment Activation linkage.
  /// Points at the exact completed HEMORRHOID_TREATMENT_DECISION v3
  /// ClinicalFormSubmission that activated the treatment episode for this
  /// Encounter. @unique: one submission can activate at most one Encounter.
  treatmentActivationSubmissionId String?                 @unique
  treatmentActivatedAt            DateTime?
  // onDelete: SetNull — a ClinicalFormSubmission is append-only and has no
  // delete route in the application boundary, so in production this pointer
  // is never actually nulled; SetNull only keeps disposable-test-DB teardown
  // tractable given the (submission -> encounter) and (encounter -> submission)
  // FK pair. Activation history itself lives in the HEMORRHOID_TREATMENT_
  // ACTIVATED AuditEvent, which is never deleted.
  treatmentActivationSubmission   ClinicalFormSubmission? @relation("EncounterTreatmentActivation", fields: [treatmentActivationSubmissionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  carePlan                   CarePlan?
  clinicalFormSubmissions    ClinicalFormSubmission[]
  sourceForFollowUpTasks     CareTask[]                   @relation("CareTaskSourceEncounter")
  completedForFollowUpTasks  CareTask[]                   @relation("CareTaskCompletedByEncounter")
  clinicianAssignmentHistory ClinicianAssignmentHistory[]
  treatmentPathwayId         String?
  treatmentPathway           TreatmentPathway?            @relation(fields: [treatmentPathwayId, tenantId, episodeId, patientId], references: [id, tenantId, caseId, patientId], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, episodeId])
  @@index([tenantId, roomId])
  @@index([tenantId, responsibleClinicianId])
  @@index([tenantId, treatmentPathwayId])
  @@map("encounters")
}

/// Facility — a physical care location, tenant-scoped. DEC-010 §C: Tenant
/// stays the security/customer workspace boundary; Facility is a distinct
/// physical-location concept. A patient/CareEpisode may have Encounters at
/// multiple Facilities within the same tenant.
model Facility {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())

  rooms Room[]

  // DEC-019 — internal Facility assignments for staff.
  staffAssignments StaffFacilityAssignment[]

  @@index([tenantId])
  @@map("facilities")
}

/// Room — a physical location within a Facility, tenant-scoped. A Room's
/// Facility must belong to the same tenant as the Room itself (ancestry
/// invariant enforced in RoomsService.create, since Prisma's schema DSL
/// cannot express a cross-field tenant-equality constraint).
model Room {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  name       String
  createdAt  DateTime @default(now())

  encounters Encounter[]

  @@index([tenantId])
  @@index([tenantId, facilityId])
  @@map("rooms")
}

/// ClinicianAssignmentHistory — append-only provenance trail for
/// responsible-clinician assignment/handover on an Encounter (DEC-010 §B).
/// One row is written at initial assignment (Encounter creation) and one
/// additional row per handover. Historical rows are never updated —
/// `previousClinicianId` records what the Encounter's responsible clinician
/// was immediately before this row took effect. This is deliberately
/// separate from AuditEvent: AuditEvent records the operational event
/// (actor, action, timestamp); this table records the clinical-responsibility
/// timeline itself, queryable without parsing AuditEvent.metadata.
model ClinicianAssignmentHistory {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  encounterId         String
  encounter           Encounter @relation(fields: [encounterId], references: [id])
  clinicianId         String
  clinician           AuthUser  @relation("AssignmentClinician", fields: [clinicianId], references: [id])
  previousClinicianId String?
  assignedByUserId    String
  reason              String?
  assignedAt          DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, encounterId])
  @@map("clinician_assignment_history")
}

enum CareEpisodeStatus {
  ACTIVE
  CLOSED
}

/// CareEpisode — explicit treatment-course grouping. episodeType remains a
/// stable string code so adding future episode types does not require a
/// database enum migration. Lifecycle actions are application-authorized and
/// audited; Episodes never start or close implicitly.
model CareEpisode {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  episodeType String
  status      CareEpisodeStatus @default(ACTIVE)
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime          @default(now())

  encounters             Encounter[]
  treatmentPathways      TreatmentPathway[] @relation("CasePathways")
  legacyTreatmentPathway TreatmentPathway?  @relation("LegacyEpisode")
  investigations         Investigation[]

  @@unique([id, tenantId, patientId])
  @@index([tenantId])
  @@index([tenantId, patientId])
  @@map("care_episodes")
}

enum CarePlanStatus {
  DRAFT
  SIGNED
}

/// CarePlan — bridge from Encounter to follow-up. DRAFT is mutable; once
/// SIGNED the signed content is immutable and lives in CarePlanVersion rows
/// (append-only). Amendment creates a new CarePlanVersion preserving lineage
/// to the previous version — see docs/04_CORE_DOMAIN_MODEL.md and
/// docs/05_ARCHITECTURE_BASELINE.md ("Signed-record immutability").
model CarePlan {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  encounterId      String           @unique
  encounter        Encounter        @relation(fields: [encounterId], references: [id])
  patientId        String
  patient          Patient          @relation(fields: [patientId], references: [id])
  status           CarePlanStatus   @default(DRAFT)
  instructions     String
  followUpDate     DateTime?
  currentVersionId String?          @unique
  currentVersion   CarePlanVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  versions  CarePlanVersion[] @relation("PlanVersions")
  careTasks CareTask[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@map("care_plans")
}

/// CarePlanVersion — append-only signed snapshot. Row is never updated once
/// created. versionNumber 1 is created on DRAFT -> SIGNED; each amendment
/// creates versionNumber N+1 with previousVersionId pointing at the prior
/// signed version, actorId + reason + signedAt recording the amendment.
model CarePlanVersion {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  carePlanId        String
  carePlan          CarePlan          @relation("PlanVersions", fields: [carePlanId], references: [id])
  versionNumber     Int
  instructions      String
  followUpDate      DateTime?
  actorId           String
  reason            String?
  previousVersionId String?
  previousVersion   CarePlanVersion?  @relation("VersionLineage", fields: [previousVersionId], references: [id])
  nextVersions      CarePlanVersion[] @relation("VersionLineage")
  signedAt          DateTime          @default(now())

  currentForPlan CarePlan? @relation("CurrentVersion")

  @@index([tenantId])
  @@index([carePlanId])
  @@map("care_plan_versions")
}

enum CareTaskType {
  FOLLOW_UP
}

/// CareTask — operational follow-up work. Stored statuses are OPEN,
/// COMPLETED, CANCELLED only. OVERDUE is a DERIVED state (status == OPEN AND
/// dueDate < now), never persisted — see docs/04_CORE_DOMAIN_MODEL.md.
///
/// CORE-04 T10 (docs/09_CORE04_IMPLEMENTATION_CONTRACT.md T10) adds Longo
/// follow-up scheduling. `carePlanId` becomes optional because a follow-up
/// CareTask is generated directly from the completed Surgery Encounter, not
/// from a CarePlan. `sourceEncounterId` is the Surgery Encounter that
/// generated the schedule (the ONLY postoperative timing anchor —
/// Encounter.occurredAt on that Encounter); `timepointCode` identifies
/// TWO_WEEK/MONTH_1/MONTH_3/MONTH_6. `completedByEncounterId` is set only
/// when a matching real visit Encounter's form is completed for that exact
/// timepoint + Episode. `episodeId` is deliberately NOT stored here — the
/// Episode is always inferred via sourceEncounter -> Encounter.episodeId,
/// per the "no episodeId duplication onto CareTask" invariant.
/// `scheduleReviewRequired` flags a task whose surgery anchor may have
/// changed after generation; it is never silently rescheduled.
model CareTask {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id])
  carePlanId  String?
  carePlan    CarePlan?      @relation(fields: [carePlanId], references: [id])
  type        CareTaskType   @default(FOLLOW_UP)
  status      CareTaskStatus @default(OPEN)
  dueDate     DateTime
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())

  sourceEncounterId      String?
  sourceEncounter        Encounter? @relation("CareTaskSourceEncounter", fields: [sourceEncounterId], references: [id])
  timepointCode          String?
  completedByEncounterId String?
  completedByEncounter   Encounter? @relation("CareTaskCompletedByEncounter", fields: [completedByEncounterId], references: [id])
  scheduleReviewRequired Boolean    @default(false)

  /// DEC-021 NR-01 — Lost to Follow-up. Both NULL unless status ==
  /// LOST_TO_FOLLOW_UP. Reason is mandatory + trimmed at the endpoint.
  lostToFollowUpAt     DateTime?
  lostToFollowUpReason String?
  contactAttempts      CareTaskContactAttempt[]

  @@unique([sourceEncounterId, timepointCode])
  @@index([tenantId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, sourceEncounterId])
  @@map("care_tasks")
}

enum CareTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
  /// DEC-021 NR-01 — terminal state set by an authorized DOCTOR or NURSE via
  /// `POST /care-tasks/:id/lost-to-follow-up` with a mandatory reason. Never
  /// auto-assigned (overdue alone never triggers it). Terminal for Package R:
  /// a later Episode close does NOT auto-cancel a LOST_TO_FOLLOW_UP task.
  LOST_TO_FOLLOW_UP
}

/// DEC-021 NR-01 — append-only record of an attempt to contact a patient for
/// a follow-up CareTask. No contact-channel taxonomy in v1: free-text `note`
/// only. Rows are never updated or deleted.
model CareTaskContactAttempt {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  careTaskId  String
  careTask    CareTask @relation(fields: [careTaskId], references: [id])
  actorId     String
  attemptedAt DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, careTaskId])
  @@map("care_task_contact_attempts")
}

/// AuditEvent — append-only Core audit mechanism. Application boundary never
/// exposes an update/delete route for this model (see docs/05_ARCHITECTURE_BASELINE.md
/// "Append-only audit").
/// AuditEvent.seq is the deterministic append-order sequence for this
/// tenant-wide audit log. createdAt (wall-clock) is informational only and
/// is NOT a reliable ordering key: same-millisecond collisions, clock
/// granularity/skew, and restore/replay can all produce createdAt ties or
/// non-monotonic values across rows that were still appended in a strict
/// order. seq is a DB-assigned monotonic sequence (assigned at insert time,
/// independent of wall-clock) and is the only column that may be used to
/// assert causal/append order of AuditEvents. Additive-only column with a
/// backfill-safe default — no existing invariant changes.
model AuditEvent {
  id         String   @id @default(uuid())
  seq        Int      @default(autoincrement())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorId    String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  metadata   Json?

  @@unique([seq])
  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}

enum ClinicalFormStatus {
  DRAFT
  COMPLETED
}

/// ClinicalFormSubmission — structured clinical form capture. DRAFT is
/// mutable; COMPLETED is immutable — CORE-04 T2 adds append-only amendment
/// lineage (see docs/09_CORE04_IMPLEMENTATION_CONTRACT.md T2). A correction
/// to a COMPLETED submission never updates that row; it inserts a new row
/// with `previousSubmissionId` pointing at it, `revisionNumber` incremented,
/// and the same `logicalGroupId`. `logicalGroupId` + `revisionNumber`
/// identify the chain; `previousSubmissionId` is independently unique so a
/// revision can never have two successors (fork protection). There is
/// deliberately NO unconditional `@@unique([encounterId, templateKey])` —
/// that would block revision >= 2. Instead, exactly one root per
/// (Encounter, templateKey) is enforced by a partial unique index applied
/// only in raw migration SQL (`WHERE "revisionNumber" = 1"`), which Prisma's
/// schema DSL cannot express — see the T2 migration for the exact SQL.
/// `responses` holds the raw item-level answers; `computedScores` holds
/// derived instrument totals (e.g. Wexner) recomputed deterministically from
/// `responses` at completion/amendment time — a convenience cache, not the
/// source of truth. See backend/src/clinical-forms/templates for the
/// code-defined field schema this validates against.
model ClinicalFormSubmission {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id])
  encounterId     String
  encounter       Encounter          @relation(fields: [encounterId], references: [id])
  templateKey     String
  templateVersion Int
  status          ClinicalFormStatus @default(DRAFT)
  responses       Json
  computedScores  Json?
  actorId         String

  logicalGroupId       String
  revisionNumber       Int
  previousSubmissionId String?                 @unique
  previousSubmission   ClinicalFormSubmission? @relation("SubmissionLineage", fields: [previousSubmissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nextSubmission       ClinicalFormSubmission? @relation("SubmissionLineage")
  amendmentReason      String?
  amendedByUserId      String?
  completedByUserId    String?
  completedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// DEC-021 §3.3 — set when this submission is the machine-checkable source
  /// of a Structured Treatment Activation for an Encounter (inverse of
  /// Encounter.treatmentActivationSubmissionId).
  activatedEncounter Encounter? @relation("EncounterTreatmentActivation")

  @@unique([logicalGroupId, revisionNumber])
  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([logicalGroupId])
  @@map("clinical_form_submissions")
}

// DEC-016: CareEpisode remains physical Case storage; no second Case table.
enum TreatmentModality {
  MEDICAL
  PROCEDURE
  SURGERY
}

enum InvestigationOrigin {
  INTERNAL_CURRENT
  ECOSYSTEM_PRIOR
  EXTERNAL_PRIOR
}

model TreatmentPathway {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  caseId          String
  patientId       String
  patient         Patient           @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  careCase        CareEpisode       @relation("CasePathways", fields: [caseId, tenantId, patientId], references: [id, tenantId, patientId], onDelete: Restrict, onUpdate: Restrict)
  modality        TreatmentModality
  methodCode      String?
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime          @default(now())
  createdByUserId String
  legacyEpisodeId String?           @unique
  legacyEpisode   CareEpisode?      @relation("LegacyEpisode", fields: [legacyEpisodeId], references: [id], onDelete: Restrict)
  encounters      Encounter[]

  @@unique([id, tenantId, caseId, patientId])
  @@index([tenantId, caseId])
  @@map("treatment_pathways")
}

model Investigation {
  id                    String                @id @default(uuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  caseId                String
  patientId             String
  patient               Patient               @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  careCase              CareEpisode           @relation(fields: [caseId, tenantId, patientId], references: [id, tenantId, patientId], onDelete: Restrict, onUpdate: Restrict)
  origin                InvestigationOrigin
  label                 String
  parentInvestigationId String?
  parent                Investigation?        @relation("InvestigationParent", fields: [parentInvestigationId, tenantId, caseId, patientId], references: [id, tenantId, caseId, patientId], onDelete: Restrict, onUpdate: Restrict)
  children              Investigation[]       @relation("InvestigationParent")
  createdByUserId       String
  createdAt             DateTime              @default(now())
  orders                InvestigationOrder[]
  results               InvestigationResult[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, caseId, patientId])
  @@index([tenantId, caseId])
  @@map("investigations")
}

model InvestigationOrder {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  investigationId  String
  investigation    Investigation         @relation(fields: [investigationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  orderedByUserId  String
  assignedToUserId String?
  requestedAt      DateTime
  requestText      String
  createdAt        DateTime              @default(now())
  results          InvestigationResult[]

  @@unique([id, tenantId, investigationId])
  @@index([tenantId, assignedToUserId])
  @@map("investigation_orders")
}

// Raw evidence, not a Diagnosis or interpretation. No attachment storage.
model InvestigationResult {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  investigationId  String
  investigation    Investigation       @relation(fields: [investigationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  orderId          String?
  order            InvestigationOrder? @relation(fields: [orderId, tenantId, investigationId], references: [id, tenantId, investigationId], onDelete: Restrict, onUpdate: Restrict)
  rawText          String
  observedAt       DateTime
  recordedByUserId String
  createdAt        DateTime            @default(now())

  @@index([tenantId, investigationId])
  @@map("investigation_results")
}

// ============================================================================
// DEC-019 — Staff Profile & Credential Management v1
// (docs/DEC-019_STAFF_PROFILE_CREDENTIAL_MANAGEMENT.md,
//  docs/15_STAFF_PROFILE_CREDENTIAL_MANAGEMENT_IMPLEMENTATION_CONTRACT.md)
//
// These entities describe who a person is professionally. They are NEVER
// authentication or clinical authorization authority; AuthUser stays the
// account/role/Clinic-Admin-capability entity and AuthRole stays exactly
// DOCTOR / NURSE / RECEPTIONIST. StaffProfile is optional and 1:1 with
// AuthUser. Every table carries a direct tenantId (never from a request DTO).
//
// The StaffFacilityAssignment invariants "at most one active primary per
// profile" and "at most one active assignment per (staffProfileId, facilityId)"
// are enforced by two PostgreSQL PARTIAL UNIQUE INDEXES that Prisma 6.x schema
// DSL cannot express; they live only in the DEC-019 migration.sql and are the
// final concurrency guard (no SERIALIZABLE, no retry; violation -> HTTP 409).
// ============================================================================

enum StaffSpecialty {
  GASTROENTEROLOGY
  COLORECTAL_SURGERY
  GENERAL_SURGERY
  OTHER
}

enum StaffCredentialType {
  LICENSE
  CERTIFICATE
  TRAINING
}

// EXPIRED is never stored — it is a derived effective state computed at read
// time (REVOKED > EXPIRED > ACTIVE).
enum StaffCredentialStatus {
  ACTIVE
  REVOKED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  COLLABORATOR
}

model StaffProfile {
  id                   String                    @id @default(uuid())
  tenantId             String
  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  authUserId           String                    @unique
  authUser             AuthUser                  @relation(fields: [authUserId], references: [id])
  fullName             String
  professionalTitle    String?
  workPhone            String?
  primarySpecialty     StaffSpecialty?
  secondarySpecialties StaffSpecialty[]
  specialtyOtherLabel  String?
  biography            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  credentials          StaffCredential[]
  employmentHistory    EmploymentHistory[]
  facilityAssignments  StaffFacilityAssignment[]

  @@index([tenantId])
  @@map("staff_profiles")
}

// issueDate/expiryDate are date-only. credentialNumber is NOT globally unique.
// Hard delete allowed for data-entry correction; mutation + audit atomic.
model StaffCredential {
  id                  String                @id @default(uuid())
  tenantId            String
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  staffProfileId      String
  staffProfile        StaffProfile          @relation(fields: [staffProfileId], references: [id])
  credentialType      StaffCredentialType
  name                String
  credentialNumber    String?
  issuingOrganization String?
  issueDate           DateTime?             @db.Date
  expiryDate          DateTime?             @db.Date
  status              StaffCredentialStatus @default(ACTIVE)
  note                String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, staffProfileId])
  @@map("staff_credentials")
}

// Overlapping records are explicitly allowed (no exclusion constraint).
// Hard delete allowed; mutation + audit atomic.
model EmploymentHistory {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  staffProfileId   String
  staffProfile     StaffProfile    @relation(fields: [staffProfileId], references: [id])
  organizationName String
  department       String?
  positionTitle    String?
  startDate        DateTime        @db.Date
  endDate          DateTime?       @db.Date
  employmentType   EmploymentType?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, staffProfileId])
  @@map("employment_history")
}

// Active assignment == endDate IS NULL. NEVER hard-deleted. facilityId and
// staffProfileId are immutable after creation. Does not grant/revoke clinical
// access and does not change AuthRole.
model StaffFacilityAssignment {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])
  facilityId     String
  facility       Facility     @relation(fields: [facilityId], references: [id])
  isPrimary      Boolean      @default(false)
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, staffProfileId])
  @@index([tenantId, facilityId])
  @@map("staff_facility_assignments")
}
